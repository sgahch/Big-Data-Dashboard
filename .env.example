# ==========================================
# 环境配置模板 (Environment Configuration Template)
# ==========================================
# 说明：这是配置文件模板，不包含真实的敏感信息
# 使用方法：
#   - 开发环境：复制为 .env.development 并填入开发环境配置
#   - 生产环境：复制为 .env.production 并填入生产环境配置
#   - 本地使用：复制为 .env 并根据实际情况填写

# Django settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True

# Database settings
DB_NAME=supervision
DB_USER=root
DB_PASSWORD=your_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Flask settings (optional, for older code)
FLASK_DEBUG=True
FLASK_PORT=5000
SECRET_KEY=your-flask-secret-key
# Coze AI 配置
# 请访问 https://www.coze.cn/ 获取 API
COZE_API_TOKEN=your-coze-api-token-here
COZE_BOT_ID=your-bot-id-here
